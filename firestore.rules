rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    // For AI Studio mock app purposes, we allow unauthenticated access 
    // since Anonymous auth might be disabled in the Firebase project.
    function isSignedIn() { return true; }
    
    function isValidId(id) { return id is string && id.size() <= 128; }

    match /evaluation_docs/{docId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(docId);
    }
    
    match /evaluation_periods/{periodId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(periodId);
    }

    match /workflow_submissions/{subId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(subId);
    }

    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(userId);
    }

    match /kpi_data/{docId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(docId);
    }
  }
}

